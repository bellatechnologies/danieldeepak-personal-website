{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"templateParts": [
		{
			"name": "dd-header",
			"title": "Site Header (Daniel Deepak)",
			"area": "header"
		},
		{
			"name": "dd-footer",
			"title": "Site Footer (Daniel Deepak)",
			"area": "footer"
		}
	],
	"settings": {
		"layout": {
			"contentSize": "1296px",
			"wideSize": "1340px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, ui-sans-serif, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/inter/Inter-VariableFont_wght.woff2"
							],
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontFamily": "Inter"
						}
					]
				},
				{
					"name": "Plus Jakarta Sans",
					"slug": "plus-jakarta-sans",
					"fontFamily": "\"Plus Jakarta Sans\", ui-sans-serif, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/plus-jakarta-sans/PlusJakartaSans-VariableFont_wght.woff2"
							],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Plus Jakarta Sans"
						}
					]
				}
			]
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#FAF9F5"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#2B2B26"
				},
				{
					"slug": "accent-1",
					"name": "Accent 1",
					"color": "#7C9470"
				},
				{
					"slug": "accent-2",
					"name": "Accent 2",
					"color": "#4B5A3F"
				},
				{
					"slug": "accent-3",
					"name": "Accent 3",
					"color": "#A8BC9D"
				},
				{
					"slug": "accent-4",
					"name": "Accent 4",
					"color": "#C9A24B"
				},
				{
					"slug": "accent-5",
					"name": "Accent 5",
					"color": "#E3CD8E"
				},
				{
					"slug": "accent-6",
					"name": "Accent 6",
					"color": "#EFEEE6"
				}
			]
		}
	},
	"styles": {
		"color": {
			"text": "#6a7282"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|plus-jakarta-sans",
					"fontWeight": "700"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|plus-jakarta-sans"
				}
			}
		}
	}
}
